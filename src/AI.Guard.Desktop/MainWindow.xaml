<Window x:Class="Rooomtech.AIGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROOOMTECH AI Guard" Height="760" Width="1040" MinHeight="660" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ROOOMTECH AI Guard" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="AIによる機密ファイル読み取りをOS側で制御" Margin="0,4,0,0"/>
            <TextBlock Text="個人私的利用：無償　｜　法人・団体・業務利用：有償・個別見積" Margin="0,6,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="12" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kernel Driver" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DriverStatusText" Text="確認中..." Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Policy Agent" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AgentStatusText" Text="確認中..." Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ライセンス" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseHeaderStatusText" Text="確認中..." Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="3" Content="状態更新" Width="100" Height="32" Click="RefreshStatus_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="保護設定">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="保護フォルダ" FontWeight="SemiBold" FontSize="16"/>
                    <ListBox x:Name="ProtectedPathsList" Grid.Column="0" Grid.Row="1" Margin="0,8,0,8"/>
                    <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                        <Button Content="フォルダ追加" Width="110" Margin="0,0,8,0" Click="AddFolder_Click"/>
                        <Button Content="削除" Width="80" Click="RemoveFolder_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="許可アプリ" FontWeight="SemiBold" FontSize="16"/>
                    <ListBox x:Name="AllowedAppsList" Grid.Column="2" Grid.Row="1" Margin="0,8,0,8" DisplayMemberPath="Display"/>
                    <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
                        <Button Content="アプリ追加" Width="110" Margin="0,0,8,0" Click="AddApp_Click"/>
                        <Button Content="削除" Width="80" Click="RemoveApp_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="ライセンス">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="利用ライセンス" FontSize="20" FontWeight="SemiBold"/>
                    <Border Grid.Row="1" Margin="0,12,0,12" Padding="14" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="LicenseStatusText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LicenseDetailText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="法人ライセンスを読み込む" Width="190" Height="34" Margin="0,0,8,0" Click="ImportBusinessLicense_Click"/>
                        <Button Content="再確認" Width="90" Height="34" Margin="0,0,8,0" Click="RefreshLicense_Click"/>
                        <Button Content="ライセンスフォルダを開く" Width="180" Height="34" Click="OpenLicenseFolder_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <TextBlock Text="個人利用" FontWeight="SemiBold"/>
                        <TextBlock Text="個人が自己の私的目的で利用する場合は無償です。ライセンスファイルは不要です。" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="法人・団体・業務利用" FontWeight="SemiBold"/>
                        <TextBlock Text="有償・個別見積です。ROOOMTECH株式会社が発行した署名付きBusinessライセンスを読み込んで利用します。" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="法人ライセンスファイルは改変すると署名検証に失敗します。秘密鍵は製品には含まれません。" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="監査ログ">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="再読込" Width="90" Margin="0,0,8,8" Click="ReloadAudit_Click"/>
                        <Button Content="ログフォルダを開く" Width="150" Margin="0,0,0,8" Click="OpenAuditFolder_Click"/>
                    </StackPanel>
                    <ListBox x:Name="AuditList" Grid.Row="1" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" VerticalAlignment="Center" Text=""/>
            <Button Grid.Column="1" Content="再読込" Width="100" Height="34" Margin="0,0,8,0" Click="ReloadPolicy_Click"/>
            <Button Grid.Column="2" Content="設定を保存" Width="120" Height="34" Click="SavePolicy_Click"/>
        </Grid>
    </Grid>
</Window>
