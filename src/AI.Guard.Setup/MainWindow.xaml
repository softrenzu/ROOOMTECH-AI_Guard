<Window x:Class="Rooomtech.AIGuard.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROOOMTECH AI Guard Setup" Height="600" Width="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ROOOMTECH AI Guard" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="生成AI時代の機密ファイル保護ソフト" FontSize="16" Margin="0,5,0,0"/>
            <TextBlock Text="1.0.0-rc.2 Commercial Release Candidate" Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,22,0,16" Padding="16" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="利用区分を選択" FontSize="18" FontWeight="SemiBold"/>
                <RadioButton x:Name="PersonalRadio" Content="個人による私的利用（無償）" IsChecked="True" Margin="0,12,0,0" Checked="UsageChanged"/>
                <RadioButton x:Name="BusinessRadio" Content="法人・団体・業務利用（有償・個別見積）" Margin="0,10,0,0" Checked="UsageChanged"/>
            </StackPanel>
        </Border>

        <Border x:Name="BusinessLicensePanel" Grid.Row="2" Padding="16" BorderThickness="1" CornerRadius="6" IsEnabled="False" Opacity="0.55">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="法人Businessライセンス" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LicensePathText" Height="32" IsReadOnly="True" VerticalContentAlignment="Center" Padding="7,0"/>
                    <Button Grid.Column="1" Content="ファイル選択" Width="110" Height="32" Margin="8,0,0,0" Click="BrowseLicense_Click"/>
                </Grid>
                <TextBlock x:Name="LicenseValidationText" Grid.Row="2" Margin="0,9,0,0" Text="法人利用ではROOOMTECH株式会社発行のライセンスが必要です。" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="14" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="重要" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Microsoft署名済みKernel Driverがパッケージに含まれないRC版では、GUIとPolicy Agentは動作しますが、Kernelレベルの強制保護は有効になりません。"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <CheckBox x:Name="AcceptLicenseCheck" Checked="FormChanged" Unchecked="FormChanged">
                <TextBlock TextWrapping="Wrap" Text="LICENSE.mdの利用条件を確認し、個人利用と法人利用の条件、および製品のセキュリティ境界に同意します。"/>
            </CheckBox>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="閉じる" Width="100" Height="38" Margin="0,0,10,0" Click="Close_Click"/>
            <Button x:Name="InstallButton" Grid.Column="2" Content="インストール" Width="140" Height="38" IsEnabled="False" Click="Install_Click"/>
        </Grid>
    </Grid>
</Window>
