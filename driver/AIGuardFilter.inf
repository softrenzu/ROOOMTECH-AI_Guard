[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ManufacturerName%
DriverVer   = 09/10/2026,1.0.0.0
CatalogFile = AIGuardFilter.cat

[DestinationDirs]
DefaultDestDir = 12
AIGuard.DriverFiles = 12

[DefaultInstall.NTamd64]
CopyFiles = AIGuard.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,AIGuard.Service

[AIGuard.Service]
DisplayName    = %ServiceDisplayName%
Description    = %ServiceDescription%
ServiceBinary  = %12%\AIGuardFilter.sys
Dependencies   = FltMgr
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "FSFilter Activity Monitor"
AddReg         = AIGuard.AddRegistry

[AIGuard.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%DefaultInstance%,"Altitude",0x00000000,%Altitude%
HKR,"Instances\"%DefaultInstance%,"Flags",0x00010001,0x0

[AIGuard.DriverFiles]
AIGuardFilter.sys

[SourceDisksFiles]
AIGuardFilter.sys = 1

[SourceDisksNames]
1 = %DiskName%,,,

[Strings]
ManufacturerName   = "ROOOMTECH株式会社"
ServiceName        = "AIGuardFilter"
ServiceDisplayName = "ROOOMTECH AI Guard Filter"
ServiceDescription = "ROOOMTECH AI Guard file system minifilter"
DefaultInstance    = "AIGuard Instance"
Altitude           = "385201"
DiskName           = "ROOOMTECH AI Guard Driver"
